#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# ///
"""Moves the five Regent sites onto one published design-system commit.

    scripts/regent-ui-update <commit> [--base <site>=<branch>]... [--site <site>]...

For each site this works in its standing update checkout,
/Users/sean/Documents/regent/worktrees/ui-standardization/update-<site>, which
nothing else uses. It starts a branch from the site's origin/main (or the
branch given with --base), pins the commit in platform/mix.exs, updates
mix.lock for regent_ui alone, then runs the site's compile, asset build and
typecheck. A site that gets through every step gets a commit on that branch;
a site already on the commit is reported current; any other site is reported
blocked, with the failing step and its log. Nothing
is pushed. Each site's owner reviews, pushes and releases the branch.
"""

import argparse
import datetime
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path('/Users/sean/Documents/regent')
DESIGN_SYSTEM = ROOT / 'repos' / 'design-system'
CHECKOUTS = ROOT / 'worktrees' / 'ui-standardization'
RUNS = CHECKOUTS / 'update-runs'

# Each site's JavaScript package, relative to the checkout.
SITES = {
    'regents': 'platform',
    'autolaunch': 'platform',
    'patchbay': 'platform/assets',
    'keyfleet': 'platform',
    'techtree': 'platform/assets',
}

PIN = re.compile(r'^(  @design_system_ref ")([0-9a-f]{40})(")$', re.M)


class Blocked(Exception):
    def __init__(self, step, detail):
        super().__init__(detail)
        self.step = step
        self.detail = detail


class AlreadyCurrent(Exception):
    pass


def run(cmd, cwd, log, step, timeout=1200):
    log.write(f'\n$ {" ".join(cmd)}  (in {cwd})\n')
    log.flush()
    try:
        done = subprocess.run(cmd, cwd=cwd, stdout=log, stderr=subprocess.STDOUT, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise Blocked(step, f'took longer than {timeout // 60} minutes')
    if done.returncode != 0:
        raise Blocked(step, f'exited with {done.returncode}')


def git(cwd, *args):
    return subprocess.run(['git', *args], cwd=cwd, capture_output=True, text=True, check=True).stdout.strip()


def published_commit(ref):
    subprocess.run(['git', 'fetch', '--quiet', 'origin'], cwd=DESIGN_SYSTEM, check=True)
    try:
        commit = git(DESIGN_SYSTEM, 'rev-parse', '--verify', f'{ref}^{{commit}}')
    except subprocess.CalledProcessError:
        sys.exit(f'{ref} is not a design-system commit.')
    if not git(DESIGN_SYSTEM, 'branch', '--remotes', '--contains', commit):
        sys.exit(f'{commit} is not on GitHub yet. Publish it first.')
    return commit


def update(site, js_dir, commit, base, log):
    checkout = CHECKOUTS / f'update-{site}'
    if not checkout.is_dir():
        raise Blocked('checkout', f'{checkout} is missing; create it with worktrees.py add '
                      f'--owner ui-standardization --name update-{site}')
    # Generated files a branch does not ignore are left alone; only the pin and lock are committed.
    if git(checkout, 'status', '--porcelain', '--untracked-files=no'):
        raise Blocked('checkout', f'{checkout} has uncommitted changes')

    run(['git', 'fetch', '--quiet', 'origin'], checkout, log, 'fetch')
    branch = f'ui/regent-ui-{commit[:7]}' + ('' if base == 'main' else '-' + base.replace('/', '-'))
    if git(checkout, 'branch', '--list', branch):
        raise Blocked('branch', f'{branch} already exists in {checkout}')
    run(['git', 'switch', '--quiet', '-c', branch, f'origin/{base}'], checkout, log, 'branch')
    try:
        return pin(checkout, js_dir, commit, branch, log)
    except (Blocked, AlreadyCurrent):
        # Leave the checkout clean and the branch gone, so the next run starts fresh.
        git(checkout, 'restore', '--staged', '--worktree', 'platform/mix.exs', 'platform/mix.lock')
        git(checkout, 'switch', '--quiet', '--detach')
        git(checkout, 'branch', '--quiet', '-D', branch)
        raise


def pin(checkout, js_dir, commit, branch, log):
    mix_exs = checkout / 'platform' / 'mix.exs'
    source = mix_exs.read_text()
    pins = PIN.findall(source)
    if len(pins) != 1:
        raise Blocked('pin', 'platform/mix.exs has no single @design_system_ref line')
    current = pins[0][1]
    if current == commit:
        raise AlreadyCurrent()
    contains = subprocess.run(['git', 'merge-base', '--is-ancestor', current, commit],
                              cwd=DESIGN_SYSTEM).returncode
    if contains == 1:
        raise Blocked('pin', f'{commit[:7]} does not contain the current pin {current[:7]}; '
                      'taking it would drop shared changes this site already has')
    if contains != 0:
        raise Blocked('pin', f'the current pin {current[:7]} is not a known design-system commit')
    mix_exs.write_text(PIN.sub(rf'\g<1>{commit}\g<3>', source))

    platform = checkout / 'platform'
    run(['mix', 'deps.update', 'regent_ui'], platform, log, 'lock')
    changed = set(git(checkout, 'diff', '--name-only').splitlines())
    if changed != {'platform/mix.exs', 'platform/mix.lock'}:
        raise Blocked('lock', f'unexpected files changed: {", ".join(sorted(changed))}')
    lock_lines = [line for line in git(checkout, 'diff', '-U0', 'platform/mix.lock').splitlines()
                  if line[:1] in '+-' and not line.startswith(('+++', '---'))]
    others = sorted({line[1:].split(':')[0].strip() for line in lock_lines
                     if not line[1:].lstrip().startswith('"regent_ui"')})
    if others:
        raise Blocked('lock', f'mix.lock also changed {", ".join(others)}')

    run(['mix', 'deps.get'], platform, log, 'deps')
    run(['npm', 'ci', '--no-audit', '--no-fund'], checkout / js_dir, log, 'npm')
    run(['mix', 'compile', '--warnings-as-errors'], platform, log, 'compile')
    run(['mix', 'assets.build'], platform, log, 'assets')
    run(['npm', 'run', 'typecheck'], checkout / js_dir, log, 'typecheck')

    run(['git', 'add', 'platform/mix.exs', 'platform/mix.lock'], checkout, log, 'commit')
    run(['git', 'commit', '--quiet', '-m', f'Use design-system {commit[:7]}'], checkout, log, 'commit')
    return branch, git(checkout, 'rev-parse', '--short', 'HEAD')


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('commit', help='a design-system commit already on GitHub')
    parser.add_argument('--base', action='append', default=[], metavar='SITE=BRANCH',
                        help='start this site from a release branch instead of main')
    parser.add_argument('--site', action='append', choices=SITES, help='only these sites')
    args = parser.parse_args()

    bases = dict(item.split('=', 1) for item in args.base)
    unknown = set(bases) - set(SITES)
    if unknown:
        sys.exit(f'--base names unknown sites: {", ".join(sorted(unknown))}')
    commit = published_commit(args.commit)
    stamp = datetime.datetime.now(datetime.UTC).strftime('%Y%m%dT%H%M%SZ')
    run_dir = RUNS / f'{stamp}-{commit[:7]}'
    run_dir.mkdir(parents=True)

    rows = []
    for site in args.site or SITES:
        base = bases.get(site, 'main')
        log_path = run_dir / f'{site}.log'
        print(f'{site} from {base} ...', flush=True)
        with log_path.open('w') as log:
            try:
                branch, short = update(site, SITES[site], commit, base, log)
                rows.append((site, base, 'updated', f'{branch} at {short}'))
            except AlreadyCurrent:
                rows.append((site, base, 'current', f'origin/{base} already pins {commit[:7]}'))
            except Blocked as blocked:
                rows.append((site, base, 'blocked', f'{blocked.step}: {blocked.detail}; log {log_path}'))
        print(f'  {rows[-1][2]}: {rows[-1][3]}', flush=True)

    table = [f'# design-system {commit} ({stamp})', '',
             '| Site | Base | Result | Detail |', '| --- | --- | --- | --- |',
             *(f'| {site} | {base} | {result} | {detail} |' for site, base, result, detail in rows)]
    (run_dir / 'summary.md').write_text('\n'.join(table) + '\n')
    print('\n' + '\n'.join(table) + f'\n\nSaved to {run_dir / "summary.md"}')
    sys.exit(0 if all(row[2] != 'blocked' for row in rows) else 1)


if __name__ == '__main__':
    main()
