  "audience": "ash-template",
  "proof_headers": [
    "x-siwa-signature",
    "x-siwa-signature-input",
    "x-siwa-receipt",
    "x-key-id",
    "x-timestamp",
    "x-agent-wallet-address",
    "x-agent-chain-id",
    "content-digest"
  ],
  "release_status": "unreleased_reference"
