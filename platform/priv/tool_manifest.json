    {
      "name": "prepare_agent_request",
      "title": "Prepare a signed agent request",
      "description": "Prepare exact bytes for a manifest-listed operation. No private read or product mutation. Sign with your existing SIWA signer, then call the named tool with input, request and proof. Never substitute browser credentials.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "input"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "agent_whoami",
              "notes_list",
              "notes_get",
              "notes_create",
              "room_post",
              "account_balances",
              "credits_history",
              "points_balance"
            ]
          },
          "input": {
            "type": "object"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      },
      "requires": "none",
      "authentication": "public",
      "pairing_required": false,
      "availability": "available",
      "state_changing": false,
      "payment": "none",
      "route": "local preparation",
      "scope": "site",
      "interfaces": {
        "webmcp": "prepare_agent_request"
      },
      "effect": "prepare"
    }
