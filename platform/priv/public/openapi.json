{
  "openapi": "3.1.0",
  "info": {
    "title": "Ash Template public API",
    "version": "1.0.0",
    "description": "Service health and the signed-in person's own profile. Does not describe browser session changes. Paths under /api/v1 stay compatible; a breaking change arrives under a new major path, and the developer documentation holds the versioning and deprecation policy.",
    "contact": {
      "name": "Ash Template"
    }
  },
  "security": [],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getServiceHealth",
        "summary": "Read web-service health",
        "description": "Returns ok when the web service is responding and its database answers; 503 unavailable otherwise. Does not establish readiness of every outside service.",
        "responses": {
          "200": {
            "description": "Web service is responding",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "const": "ok"
                }
              }
            }
          },
          "503": {
            "description": "The web service is up but its database is not answering",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "const": "unavailable"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client address in the current window",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, such as an unknown address or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "operationId": "getMyProfile",
        "summary": "Read the profile of the verified account",
        "description": "Returns the profile that belongs to the presented Privy credentials. Responses use Cache-Control: no-store.",
        "security": [
          {
            "PrivyAccessToken": [],
            "PrivyIdentityToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ExpectedSubject"
          }
        ],
        "responses": {
          "200": {
            "description": "The verified account's profile",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Both Privy credentials were not present and valid",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The credentials do not own this profile",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The profile has not been created yet; call POST /api/v1/profile/sync",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in is not configured or the profile service is unavailable",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client address in the current window",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, such as an unknown address or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateMyProfile",
        "summary": "Update the profile of the verified account",
        "description": "Changes the display name or the selected wallet. The body is JSON with at least one of the two fields and nothing else.",
        "security": [
          {
            "PrivyAccessToken": [],
            "PrivyIdentityToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ExpectedSubject"
          },
          {
            "name": "X-Regent-Profile-Id",
            "in": "header",
            "required": false,
            "description": "If supplied, must match the id of the profile being updated.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated profile",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid JSON",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Both Privy credentials were not present and valid",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The credentials do not own this profile",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "The body is larger than 8192 bytes",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "The update is invalid or the profile has not been created yet",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in is not configured or the profile service is unavailable",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client address in the current window",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, such as an unknown address or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profile/sync": {
      "post": {
        "operationId": "syncMyProfile",
        "summary": "Create or refresh the profile of the verified account",
        "description": "Creates the profile on first use and refreshes it from the presented sign-in evidence afterwards.",
        "security": [
          {
            "PrivyAccessToken": [],
            "PrivyIdentityToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ExpectedSubject"
          }
        ],
        "responses": {
          "200": {
            "description": "The current profile",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Both Privy credentials were not present and valid",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The credentials do not own this profile",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The presented evidence conflicts with the stored profile",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in is not configured or the profile service is unavailable",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client address in the current window",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Any other error, such as an unknown address or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PrivyAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Privy access token for the requesting account."
      },
      "PrivyIdentityToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Privy-Id-Token",
        "description": "Privy identity JWT, required alongside the access token. Not an API key."
      }
    },
    "parameters": {
      "ExpectedSubject": {
        "name": "X-Privy-User-Id",
        "in": "header",
        "required": false,
        "description": "If supplied, must exactly match the verified account subject. It never selects another account.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ProfileEnvelope": {
        "type": "object",
        "required": [
          "profile"
        ],
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "profile_id",
          "verification_basis",
          "evidence_issued_at",
          "display_name",
          "linked_wallets",
          "wallet",
          "x"
        ],
        "properties": {
          "profile_id": {
            "type": "string"
          },
          "verification_basis": {
            "type": "string",
            "const": "last_synchronized_privy_proof"
          },
          "evidence_issued_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "linked_wallets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$"
            }
          },
          "wallet": {
            "type": "object",
            "required": [
              "address",
              "verified"
            ],
            "properties": {
              "address": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^0x[a-fA-F0-9]{40}$"
              },
              "verified": {
                "type": "boolean",
                "description": "True when the selected wallet is one of the linked wallets."
              }
            }
          },
          "x": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "username",
              "display_name",
              "verified",
              "source"
            ],
            "properties": {
              "username": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "display_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verified": {
                "type": "boolean",
                "const": true
              },
              "source": {
                "type": "string",
                "const": "privy"
              }
            }
          }
        }
      },
      "ProfileUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "wallet_address": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^0x[a-fA-F0-9]{40}$"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "A stable machine-readable code. Profile answers use the codes in examples; any other error uses its status name in snake case, such as not_found or too_many_requests.",
                "examples": [
                  "authentication_required",
                  "profile_unconfigured",
                  "profile_unavailable",
                  "profile_not_created",
                  "profile_forbidden",
                  "invalid_profile_update",
                  "invalid_profile_json",
                  "profile_request_too_large",
                  "json_required",
                  "identity_evidence_conflict",
                  "method_not_allowed",
                  "not_found",
                  "too_many_requests",
                  "internal_server_error"
                ]
              },
              "message": {
                "type": "string",
                "description": "What went wrong, in words."
              },
              "hint": {
                "type": "string",
                "description": "What to do next."
              }
            }
          }
        }
      }
    },
    "headers": {
      "RateLimitPolicy": {
        "description": "The budget this request counted against, as \"policy\";q=requests;w=window seconds. Each client address has 120 requests per 60 seconds, shared by the health check and the API.",
        "schema": {
          "type": "string"
        },
        "example": "\"default\";q=120;w=60"
      },
      "RateLimit": {
        "description": "What is left of that budget, as \"policy\";r=remaining;t=seconds until the window resets.",
        "schema": {
          "type": "string"
        },
        "example": "\"default\";r=119;t=42"
      },
      "RetryAfter": {
        "description": "Seconds to wait before the window resets.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
