<!DOCTYPE html> <% metadata =
  AshTemplateWeb.PublicDocuments.metadata(@conn.request_path, @page_title, @page_description) %>
<html lang="en" data-theme={@theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metadata.description} />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix={metadata.suffix}>{@page_title}</.live_title>
    <link rel="icon" type="image/svg+xml" sizes="any" href={~p"/favicon.svg?v=2"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/ash_ai_chat.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
