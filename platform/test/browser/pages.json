    {"route": "/openapi.json", "purpose": "Describe the site's API.", "type": "application/json"},
    {"route": "/sitemap.xml", "purpose": "List the pages for search engines.", "type": "application/xml"},
    {"route": "/robots.txt", "purpose": "Tell crawlers what they may read.", "type": "text/plain"},
    {"route": "/llms.txt", "purpose": "Give language models the site in brief.", "type": "text/plain"},
