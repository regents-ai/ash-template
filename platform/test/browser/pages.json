      "route": "/agents/:agent/skill.md",
      "paths": ["/agents/other/skill.md", "/agents/codex/skill.md", "/agents/grok-bot/skill.md", "/agents/muse/skill.md", "/agents/hermes/skill.md", "/agents/dots/skill.md", "/agents/ironclaw/skill.md", "/agents/openclaw/skill.md", "/agents/claude-code/skill.md", "/agents/pi/skill.md"],
