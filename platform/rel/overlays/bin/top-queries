#!/bin/sh
set -eu

# Read-only. The release-command setting only spares this command the web server's
# settings; the report itself connects on the serving login (AshTemplate.Release).
count="${1:-20}"

ASH_TEMPLATE_RELEASE_COMMAND=migrate ASH_TEMPLATE_TOP_QUERIES="$count" exec "$(dirname "$0")/ash_template" eval 'AshTemplate.Release.top_queries(System.fetch_env!("ASH_TEMPLATE_TOP_QUERIES"))'
