# Copy this file to .env, keep machine-specific overrides in .env.local,
# and load both from your ignored .envrc with direnv.
#
# Suggested ignored .envrc contents:
#   source_env .env
#   source_env_if_exists .env.local
#
# After direnv loads the values, prepare the guarded local database with:
#   mix ash_template.setup_local_auth
#
# Never commit .env, .env.local, or .envrc.

# Privy browser sign-in.
export PRIVY_APP_ID=''

# ES256 verification PUBLIC key, not the Privy app secret: the PEM exactly as
# Privy shows it, with real line breaks. Example shape:
# export PRIVY_VERIFICATION_KEY='-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----'
export PRIVY_VERIFICATION_KEY=''

# Credits by card or Link through Stripe. Leave all three empty to offer USDC only.
# Test keys offer card payment to Credits admins only. Locally, the webhook secret
# is the one `stripe listen --forward-to localhost:4000/api/stripe/notices` prints.
export STRIPE_SECRET_KEY=''
export STRIPE_PUBLISHABLE_KEY=''
export STRIPE_WEBHOOK_SECRET=''

# Deployment-only variable names. Supply values through the deployment's secret store.
# ASH_TEMPLATE_APP_SURFACES
# ASH_TEMPLATE_SHOWCASE
# ASH_TEMPLATE_DEPLOYMENT_ROLE
# ASH_TEMPLATE_NOTES_WEBHOOK_URL
# ASH_TEMPLATE_INDEXNOW_KEY
# ASH_TEMPLATE_SIWA_BROKER_URL
# ASH_TEMPLATE_CLAUDE_CONNECTOR_ENABLED
# SIWA_HOSTED_SIGNING_KEY
# SIWA_SITE_VERIFY_KEY
# OPENROUTER_API_KEY
# ETHEREUM_READ_RPC_URL
# OPENROUTER_DECISIONS_URL
# PHX_HOST
# SECRET_KEY_BASE
# PORT
# DATABASE_POOLED_URL
# DATABASE_DIRECT_URL
# ASH_TEMPLATE_DATABASE_TARGET_MODE
# ASH_TEMPLATE_DATABASE_CLUSTER_ID
# ASH_TEMPLATE_DATABASE_CLUSTER_NAME
