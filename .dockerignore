# The image is built from the repository root (platform/Dockerfile). Only the
# app in platform/, the build skills in skills/ and the command list the
# capability list reads enter the context.
*
!platform/
!skills/
!cli/commands.json

# Build output, fetched dependencies and local state stay out of the image
# context; the build fetches dependencies itself from mix.lock and
# package-lock.json.
platform/_build/
platform/deps/
platform/node_modules/
platform/tmp/
platform/priv/static/assets/
platform/priv/static/cache_manifest.json
platform/assets/vendor/
platform/priv/static/images/regent-ui/
platform/priv/static/fonts/regent-ui/
platform/.elixir_ls/
platform/erl_crash.dump

# Runtime environment files never enter the image.
**/.env
**/.env.*
**/.envrc
